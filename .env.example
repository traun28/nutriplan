# ─────────────────────────────────────────────────────────────────────────────
# Personalised Diet Planner — environment configuration
#
# Copy to `.env` for local development. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection used by Drizzle for persistent storage
# (users, sessions, profiles, plans, datasets, attachments).
# In production set this to your managed database (Neon, Supabase, RDS, …).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Optional for Vercel + Neon: set this to the DIRECT (non-pooler) URL for
# automatic startup migrations. Keep DATABASE_URL pooled for application queries.
# If unset, migrations fall back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST:PORT/DATABASE

# For a fully local development database (no hosted service, no system
# install) run `npm run db:local` and use:
#   DATABASE_URL=postgresql://nutriplan:nutriplan@127.0.0.1:5432/nutriplan

# ── Optional ──────────────────────────────────────────────────────────────────
# None of the following are required. The planner needs no API keys: the AI
# assistant is rule-based by default and runs entirely on your own data, and
# document processing (PDF/DOCX/XLSX) runs on the server with bundled libraries.
#
# NODE_ENV=production            # set automatically by `next start`
# PORT=3000                      # optional port for the production server
# DEV_ALLOWED_ORIGINS=           # comma-separated extra origins allowed to reach
#                                # `next dev` (e.g. a phone on your LAN); ignored in production

# ── Phase 6: AI assistant (OPTIONAL) ─────────────────────────────────────────
# The assistant works without any provider: answers are generated from the
# application's own data. Configure a provider only to have replies phrased
# by a language model. Keys are read server-side only and never logged.
# AI_PROVIDER=openai          # openai | anthropic | none (default: none)
# AI_API_KEY=YOUR_PROVIDER_API_KEY   # provider API key (placeholder — set your own)
# AI_MODEL=                   # optional; defaults: gpt-4o-mini / claude-3-5-haiku-latest
# AI_BASE_URL=                # optional; OpenAI-compatible gateway or proxy
# AI_TIMEOUT_MS=20000         # optional request timeout
